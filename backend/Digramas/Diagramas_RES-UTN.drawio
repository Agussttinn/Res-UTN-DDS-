/mxCell><mxCell id="v94" value="Sobre Especialidad (a futuro): otras especialidades&lt;br&gt;(por ej. Mecánica). Cada alumno vería solo las&lt;br&gt;materias de su especialidad." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#EEEEEE;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" vertex="1" parent="1"><mxGeometry x="890" y="1370" width="330" height="59" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="entidad-relación" name="Entidad-Relación"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6F65;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1480" height="56" as="geometry"/></mxCell><mxCell id="v3" value="Diagrama Entidad-Relación (E-R) en notación UML" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="888" height="40" as="geometry"/></mxCell><mxCell id="v4" value="RES-UTN · UTN FRD · Desarrollo de Software" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1056" y="8" width="400" height="40" as="geometry"/></mxCell><mxCell id="v5" value="Versión con las correcciones de la cátedra · base: backend/core/models.py y README del repositorio" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="24" y="1364" width="1432" height="24" as="geometry"/></mxCell><mxCell id="v6" value='&lt;span style="font-size:9px;font-weight:normal"&gt;«table»&lt;/span&gt