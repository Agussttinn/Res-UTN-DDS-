id" style="html=1;rounded=0;endArrow=open;endFill=0;endSize=8;strokeColor=#34495E;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=none;" edge="1" parent="1" source="v14" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l72" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e71"><mxGeometry x="-0.82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l73" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e71"><mxGeometry x="0.82" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="v74" value="Notación UML: cada tabla es una clase «table».&lt;br&gt;{PK} clave primaria · {FK} clave foránea · {UQ} única&lt;br&gt;Nombres de tablas en plural. Roles y estados del material&lt;br&gt;son tablas: se pueden agregar valores sin cambiar el esquema.&lt;br&gt;La última media del material se guarda en materiales&lt;br&gt;(se actualiza al votar), sin recalcular en cada consulta." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" vertex="1" parent="1"><mxGeometry x="60" y="1200" width="460" height="104" as="geometry"/></mxCell><mxCell id="v75" value="archivo, dia, hora_inicio y hora_fin admiten NULL solo&lt;br&gt;por registros anteriores; la API los exige al crear." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" vertex="1" parent="1"><mxGeometry x="560" y="1200" width="400" height="44" as="geometry"/></mxCell><mxCell id="v76" value="Tipos en MariaDB: int = bigint (id y claves foráneas),&lt;br&gt;text = longtext, bool = tinyint(1), datetime = datetime(6).&lt;br&gt;«default 0»: lo aplica Django, la base no lo guarda." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" vertex="1" parent="1"><mxGeometry x="1000" y="1200" width="440" height="59" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="estados-(material)" name="Estados (Material)"><mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2F6F65;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="56" as="geometry"/></mxCell><mxCell id="v3" value="Diagrama de Estados (Entidad: Material)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="900" height="40" as="geometry"/></mxCell><mxCell id="v4" value="RES-UTN · UTN FRD · Desarrollo de Software" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=13;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1076" y="8" width="400" height="40" as="geometry"/></mxCell><mxCell id="v5" value="Versión con las correcciones de la cátedra · base: backend/core/models.py y README del repositorio" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="24" y="1064" width="1452" height="24" as="geometry"/></mxCell><mxCell id="v6" value="" style="ellipse;fillColor=#222222;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="820" y=