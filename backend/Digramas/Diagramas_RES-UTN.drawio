lAlign=middle;fontSize=13;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1136" y="8" width="400" height="40" as="geometry"/></mxCell><mxCell id="v5" value="Versión con las correcciones de la cátedra · base: backend/core/models.py y README del repositorio" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="24" y="974" width="1512" height="24" as="geometry"/></mxCell><mxCell id="v6" value='&lt;b style="font-size:13px"&gt;Capa de presentación — PWA en el navegador&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Angular + Tailwind CSS (Mobile-First, instalable)&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fillColor=#E8F0FB;strokeColor=#1F5F9E;" vertex="1" parent="1"><mxGeometry x="291" y="103" width="1176" height="216" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Moderación y administración&lt;/b&gt;&lt;br&gt;solo rol administrador" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v6"><mxGeometry x="8" y="46" width="216" height="38" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Notificaciones&lt;/b&gt;&lt;br&gt;campanita (consulta cada 60 s)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v6"><mxGeometry x="247" y="46" width="209" height="38" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Clases de apoyo&lt;/b&gt;&lt;br&gt;grilla · suscripción · mensajes" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v6"><mxGeometry x="482" y="46" width="198" height="38" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Materias y materiales&lt;/b&gt;&lt;br&gt;listar · filtrar por especialidad, año y tipo&lt;br&gt;subir · puntuar ★" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v6"><mxGeometry x="706" y="40" width="246" height="50" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Autenticación&lt;/b&gt;&lt;br&gt;login · registro con legajo" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v6"><mxGeometry x="994" y="46" width="171" height="38" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;Núcleo de la app&lt;/b&gt;&lt;br&gt;sesión · guardas de ruta · interceptor Bearer&lt;br&gt;Service Worker + manifest (PWA)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F4F8FE;strokeColor=#34495E;" vertex="1" parent="v6"><mxGeometry x="437" y="159" width="286" height="50" as="geometry"/></mxCell><mxCell id="v13" value='&lt;b style="font-size:13px"&gt;Capa de aplicación — API REST&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px"&gt;Django 5 + Django REST Framework · http://127.0.0.1:8000/api&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;fillColor=#E4F1EE;strokeColor=#1E6B5C;" vertex="1" parent="1"><mxGeometry x="47" y="448" width="1342" height="346" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Endpoints REST&lt;/b&gt;&lt;br&gt;/usuarios · /roles · /especialidades · /materias?especialidad=&lt;br&gt;/materiales · /clases-apoyo · /ponderaciones · /notificaciones" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="639" y="40" width="375" height="50" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;Reglas de negocio&lt;/b&gt;&lt;br&gt;moderación por estados (pendiente · aprobado · rechazado · archivado)&lt;br&gt;1 voto por usuario y material · se guarda la última media en el material&lt;br&gt;no votar lo propio ni lo no aprobado · borrados protegidos (409)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="220" y="159" width="440" height="61" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Permisos por rol (RBAC)&lt;/b&gt;&lt;br&gt;roles definidos en la tabla roles&lt;br&gt;el rol se consulta en la BD en cada request" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="689" y="165" width="275" height="50" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;Autenticación y límites&lt;/b&gt;&lt;br&gt;token Bearer (8 h) · 10 intentos/min en login y registro" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="990" y="170" width="344" height="38" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;Validación de archivos&lt;/b&gt;&lt;br&gt;extensiones permitidas · máximo 10 MB" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="8" y="294" width="259" height="38" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Observer (observador.py)&lt;/b&gt;&lt;br&gt;ClaseApoyo (sujeto) → suscritos → Notificacion" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="293" y="294" width="297" height="38" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;Modelos / ORM&lt;/b&gt;&lt;br&gt;Rol · Usuario · Especialidad · Materia · EstadoMaterial · Material&lt;br&gt;ClaseApoyo · Ponderacion · Suscripcion · MensajeClase · Notificacion" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#34495E;" vertex="1" parent="v13"><mxGeometry x="614" y="289" width="421" height="50" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;Integración con S