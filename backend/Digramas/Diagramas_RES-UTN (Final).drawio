        <mxCell id="v74" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" value="Notación UML: cada tabla es una clase «table».&lt;br&gt;{PK} clave primaria · {FK} clave foránea · {UQ} única&lt;br&gt;Nombres de tablas en plural. Roles y estados del material&lt;br&gt;son tablas: se pueden agregar valores sin cambiar el esquema.&lt;br&gt;La última media del material se guarda en materiales&lt;br&gt;(se actualiza al votar), sin recalcular en cada consulta." vertex="1">
          <mxGeometry height="104" width="460" x="60" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="v75" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" value="archivo, dia, hora_inicio y hora_fin admiten NULL solo&lt;br&gt;por registros anteriores; la API los exige al crear." vertex="1">
          <mxGeometry height="44" width="400" x="560" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="v76" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" value="Tipos en MariaDB: int = bigint (id y claves foráneas),&lt;br&gt;text = longtext, bool = tinyint(1), datetime = datetime(6).&lt;br&gt;«default 0»: lo aplica Django, la base no lo guarda." vertex="1">
          <mxGeometry height="59" width="440" x="1000" y="1200" as="geometry" />
        </mxCell>
