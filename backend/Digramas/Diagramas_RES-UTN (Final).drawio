        <mxCell id="v92" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" value="Patrón Observer (lado del alumno)&lt;br&gt;ClaseApoyo = sujeto · Suscripcion = observador&lt;br&gt;1. El tutor modifica o cancela la clase, o envía un mensaje&lt;br&gt;2. ClaseApoyo.notificarSuscritos(evento)&lt;br&gt;3. Se crea una Notificacion por cada Alumno suscrito&lt;br&gt;4. El Alumno la ve en la campanita y la marca como leída" vertex="1">
          <mxGeometry height="104" width="380" x="60" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="v93" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF8DC;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" value="Sobre Rol: los roles son datos (tabla roles).&lt;br&gt;Agregar un rol nuevo no cambia el esquema.&lt;br&gt;Alumno, Tutor y Administrador son los roles actuales." vertex="1">
          <mxGeometry height="59" width="330" x="500" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="v94" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#EEEEEE;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=10;size=9;" value="Sobre Especialidad (a futuro): otras especialidades&lt;br&gt;(por ej. Mecánica). Cada alumno vería solo las&lt;br&gt;materias de su especialidad." vertex="1">
          <mxGeometry height="59" width="330" x="890" y="1370" as="geometry" />
        </mxCell>
      </root>
